# Self-contained build: compiles the frontend and the Go binary from source and
# stuffs the static assets into it. Use this to deploy a fork or an unreleased
# commit (e.g. from EasyPanel / Coolify / `docker build`). The plain `Dockerfile`
# only packages a binary that GoReleaser has already built.
#
#   docker build -f Dockerfile.build -t libredesk:custom .
#
# Build args:
#   LIBREDESK_VERSION  version string shown in the UI (default v0.0.0-custom)
#   NODE_HEAP_MB       Node heap cap for the Vite build (default 1536). The
#                      frontend build is the memory-hungry step: if it dies with
#                      "Killed" / exit code 137, the host ran out of RAM. Lower
#                      this to fit (e.g. 1024 on a 2 GB box), or add swap.

# ---- Frontend ---------------------------------------------------------------
FROM node:20-alpine AS frontend
ARG LIBREDESK_VERSION=v0.0.0-custom
ARG NODE_HEAP_MB=1536
ENV VITE_APP_VERSION=${LIBREDESK_VERSION}
ENV COREPACK_INTEGRITY_KEYS=0
# Cypress is only used by the e2e suite; downloading its binary here wastes
# time and ~400 MB of image layer for nothing.
ENV CYPRESS_INSTALL_BINARY=0
WORKDIR /src/frontend
RUN corepack enable
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
COPY static/ ../static/
# Build the two apps one at a time, each in its own process, so peak memory is
# one app's build rather than both.
RUN VITE_LOW_MEMORY=1 NODE_OPTIONS=--max-old-space-size=${NODE_HEAP_MB} pnpm build:main \
 && VITE_LOW_MEMORY=1 NODE_OPTIONS=--max-old-space-size=${NODE_HEAP_MB} pnpm build:widget

# ---- Backend ----------------------------------------------------------------
FROM golang:1.25-alpine AS backend
ARG LIBREDESK_VERSION=v0.0.0-custom
RUN apk --no-cache add make git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /src/frontend/dist ./frontend/dist
# build-backend + stuff, skipping the frontend targets (already built above).
RUN LIBREDESK_VERSION=${LIBREDESK_VERSION} make build-backend \
 && LIBREDESK_VERSION=${LIBREDESK_VERSION} make stuff

# ---- Runtime (mirrors ./Dockerfile) ----------------------------------------
FROM alpine:3.18
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /libredesk
COPY --from=backend /src/libredesk .
COPY config.sample.toml config.toml
EXPOSE 9000
CMD ["./libredesk"]
